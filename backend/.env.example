# ========================================
# MySQL（Docker）環境設定
# ========================================

# MySQL管理者パスワード
MYSQL_ROOT_PASSWORD=change_me_root_password

# 作成するデータベース名
MYSQL_DATABASE=phpdb

# アプリケーション用MySQLユーザー
MYSQL_USER=memo_user

# アプリケーション用MySQLパスワード
MYSQL_PASSWORD=change_me_user_password